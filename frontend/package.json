{
  "name": "thokan-cloud-frontend",
  "version": "1.0.13",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "prebuild": "if [ -f ../scripts/sync_version.py ] && [ -f ../VERSION ]; then python3 ../scripts/sync_version.py; else echo 'Skipping version sync (VERSION/scripts not available in this build context)'; fi",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "capacitor:sync": "cap sync",
    "capacitor:open:ios": "cap open ios",
    "capacitor:open:android": "cap open android",
    "capacitor:build:ios": "next build && cap copy && cap sync ios",
    "capacitor:build:android": "next build && cap copy && cap sync android"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/network": "^6.0.0",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.477.0",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^6.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^6"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
